---
import Site from "../layouts/Site.astro";

const news = [
  {
    date: "2026-09-30",
    label: "Sep 2026",
    title: "Sparse-WAM: Accelerating World Action Models via Action-Guided Sparse Imagination",
    description: "Selects future-frame tokens using action-to-future attention and reuses the selection across sparse denoising steps.",
    href: "https://arxiv.org/abs/2609.38984",
    linkLabel: "Paper",
    image: "/images/projects/sparse-wam-architecture.webp",
    imageAlt: "Sparse-WAM overview showing token selection at a full step and reuse during sparse steps",
    imageHeight: 743,
  },
  {
    date: "2025",
    label: "FPT 2025",
    title: "Reconfigurable Dataflow Architecture for Multiple Activation Functions on FPGA",
    description: "Composes shared BF16 operators into reconfigurable pipelines for multiple activation functions.",
    href: "https://github.com/FPGA-acceleration/FPT25-Activation-Function-Accelerator",
    linkLabel: "Code",
    image: "/images/projects/fpt25-architecture.webp",
    imageAlt: "FPGA dataflow with memory, interconnect, shared operators, and output multiplexing",
    imageHeight: 933,
  },
];
---
<Site title="Xinling Xie" description="Xinling Xie studies microelectronics at Nanjing University and works on GPU inference, hardware acceleration, and robotics." section="home">
  <section class="profile" aria-labelledby="name">
    <div>
      <h1 id="name">Xinling Xie</h1>
      <p class="education">Microelectronics undergraduate at Nanjing University.</p>
      <ul class="honors" aria-label="Selected honors">
        <li>China National Scholarship <time datetime="2026">(2026)</time></li>
        <li>1st in FPT Design Competition <time datetime="2025">(2025)</time></li>
      </ul>
      <p class="research-interest">I’m interested in GPU inference, hardware acceleration, and efficient systems for robotics.</p>
    </div>
    <img class="profile-portrait" src="/images/xinling-xie-full.webp" width="432" height="798" alt="Xinling Xie by the sea" />
  </section>

  <section class="news" aria-labelledby="news-heading">
    <h2 id="news-heading">News</h2>
    <ol class="entry-list">
      {news.slice(0, 5).map((item) => (
        <li class="entry">
          <a class="news-figure" href={item.image} aria-label={`Open architecture diagram for ${item.title}`}>
            <img src={item.image} alt={item.imageAlt} width="1320" height={item.imageHeight} />
          </a>
          <div class="news-details">
            <time datetime={item.date}>{item.label}</time>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <a class="project-link" href={item.href} aria-label={`${item.linkLabel} for ${item.title}`}>{item.linkLabel}<span aria-hidden="true"> ↗</span></a>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Site>
